# dependencies
node_modules/

# Bun lockfile — apps/mobile is npm-only (CLAUDE.md), but bun occasionally
# leaks a bun.lock in here from editor extensions or accidental runs. Keep
# package-lock.json canonical; ignore the bun one so it can't get committed
# and so EAS doesn't pick bun as the package manager.
apps/mobile/bun.lock

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.kotlin/
*.orig.*

# Metro
.metro-health-check*

# Vite (web)
apps/web/dist/

# Build artifacts
build/
bin/

# Go
apps/backend/bin/
apps/backend/server
apps/backend/server.exe

# APK / release artifacts
*.apk
*.aab
*.ipa
# Exception: APKs in the web service's public/downloads/ are intentional
# release artifacts (we host them at kaata.af/downloads/ until Play Store).

# logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# env files: ignore ALL env files so a real secret can never be staged by
# `git add .` — most importantly apps/backend/.env.mesh, the Ed25519 mesh
# signing PRIVATE key emitted by `go run ./cmd/genkeypair`. Keep the tracked
# *.example / *.production TEMPLATES (placeholders only; real values live in
# Dokploy/EAS, never in-repo).
.env
.env.*
!.env.example
!.env.production

# OS
.DS_Store
Thumbs.db
*.pem

# typescript
*.tsbuildinfo

# generated native folders (Expo prebuild output)
apps/mobile/ios/
apps/mobile/android/

credentials/
*.p8
