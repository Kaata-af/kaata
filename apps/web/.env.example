# Build-time env vars for the web app. Vite reads these from `.env`,
# `.env.local`, or the build environment (Dokploy's env panel for prod).
# All are optional — see apps/web/src/env.ts for the defaults.

# Backend API base URL (used by the future /v/:token customer view).
# Local dev: http://localhost:8080
# Production: https://api.kaata.af
VITE_BACKEND_URL=https://api.kaata.af

# WhatsApp contact link in the footer.
VITE_WHATSAPP_CONTACT_URL=https://wa.me/93781696644

# APK distribution. Either set VITE_APK_DOWNLOAD_URL to a full URL
# (e.g. an EAS artifact or CDN), or leave the URL unset and just bump
# VITE_APK_VERSION — the default URL is `/downloads/kaata-${VERSION}.apk`
# served from the web's public/ directory.
VITE_APK_VERSION=0.1.0
# VITE_APK_DOWNLOAD_URL=https://example.com/kaata-0.1.0.apk
