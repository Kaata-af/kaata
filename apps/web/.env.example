# Local-dev defaults for the web app. Copy to `.env.local` and adjust if
# your backend or APK host isn't on localhost. Vite reads `.env`, `.env.local`,
# `.env.development`, and `.env.production` automatically — see env.ts for
# the runtime fallbacks if a var is unset.

# Backend API base URL (used by /v1/visit beacon and the /v1/download
# button). For local dev the Go backend listens on :8080.
VITE_BACKEND_URL=http://localhost:8080

# WhatsApp contact link in the footer. Same value across dev and prod —
# this is the public contact, not a per-env secret.
VITE_WHATSAPP_CONTACT_URL=https://wa.me/93781696644

# APK metadata. The download button itself hits the backend's /v1/download
# (which 302s to the real APK), so APK_DOWNLOAD_URL is only used if you
# wire a direct link somewhere. Leaving it unset falls back to
# `/downloads/kaata-${APK_VERSION}.apk` served from public/.
VITE_APK_VERSION=0.1.0
# VITE_APK_DOWNLOAD_URL=

# NOTE: the admin-dashboard key is intentionally NOT a VITE_ var. VITE_* values
# are baked into the public bundle served to every visitor, so it would leak the
# admin secret. Log in on /admin with the paste-once box instead (the key is
# stored only in that browser's localStorage; the backend Bearer check enforces it).
