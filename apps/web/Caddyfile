# Container-internal Caddyfile. Dokploy's outer proxy handles the kaata.af
# domain binding and TLS termination. This serves the static SPA on :80 AND
# proxies the shared-ledger SSR to the Go backend, so WhatsApp link cards show
# the per-customer balance instead of the generic site box-logo.

:80 {
	encode gzip

	# Security headers on every response. CSP is added per-handle below (the
	# shared-ledger SSR at /v/* renders a backend inline script the SPA's
	# script-src 'self' would block, so it must not inherit the SPA CSP).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Shared-ledger preview. The share link is kaata.af/v/<token>, but the
	# per-customer SSR (per-person og:title/og:description, NO box-logo image) is
	# rendered by the Go backend — reachable publicly at api.kaata.af. Proxy the
	# SSR page and the snapshot API its inline script fetches there. The Host
	# header is rewritten to api.kaata.af so the outer proxy routes to the BACKEND
	# (leaving it as kaata.af would route back to THIS web service — a loop).
	# On any backend error, handle_errors below serves the SPA instead, so this
	# can never hard-fail the page (worst case = today's generic preview).
	@sharessr path /v/* /v1/shared/*
	handle @sharessr {
		reverse_proxy https://api.kaata.af {
			header_up Host api.kaata.af
		}
	}

	# Everything else: the static SPA bundle with client-side routing fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# CSP for the SPA (index.html has no inline script; the bundle loads
		# hashed JS/CSS + self-hosted fonts from this origin, calls the API, and
		# the download button frames the GitHub release asset in a hidden iframe).
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.kaata.af; frame-src https://github.com https://objects.githubusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}

		# index.html must always be revalidated: a heuristically-cached stale
		# shell would reference hashed chunks a later deploy has deleted and
		# white-screen until a hard refresh. Hashed assets stay immutable below.
		@html path / /index.html
		header @html Cache-Control "no-cache"

		# Aggressive cache for hashed asset files (Vite emits content-hashed names).
		@hashed_assets path /assets/*
		header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

		# APK downloads: force correct MIME + Content-Disposition so the browser
		# downloads the file rather than guessing.
		@apk path *.apk
		header @apk {
			Content-Type "application/vnd.android.package-archive"
			Content-Disposition "attachment"
		}
	}

	# Backend unreachable / 5xx → fall back to the SPA shell (its React
	# /v/:token view still renders the ledger from the API directly).
	handle_errors {
		root * /srv
		rewrite * /index.html
		file_server
	}
}
