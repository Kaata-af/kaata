# Container-internal Caddyfile. Dokploy's outer proxy handles the kaata.af
# domain binding and TLS termination. This serves the static SPA on :80 AND
# proxies the shared-ledger SSR to the Go backend, so WhatsApp link cards show
# the per-customer balance and bill preview instead of the homepage preview.

:80 {
	encode gzip

	# Security headers on every response. CSP is added per-handle below (the
	# shared-ledger SSR at /v/*, /v2/* and /v3/* renders a backend inline script the SPA's
	# script-src 'self' would block, so it must not inherit the SPA CSP).
	header {
		X-Content-Type-Options "nosniff"
		# Token pages set no-referrer upstream; only supply the site default
		# when absent. A forced value here would override their stricter policy.
		?Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Go-rendered token pages. Bills use /v3/<token>, /v2/<token> or legacy /v/, and the
	# mutual-tab link kaata.af/t/<token>, but both per-link SSR shells (per-person
	# OG text, plus branded preview images on bills) are rendered by the Go backend —
	# reachable publicly at api.kaata.af. Proxy each page AND the API its inline
	# script fetches (/v1/shared/* for bills, /v1/tabs/* for tabs — the tab page
	# fetches relatively when PUBLIC_API_BASE_URL is unset). The Host header is
	# rewritten to api.kaata.af so the outer proxy routes to the BACKEND (leaving
	# it as kaata.af would route back to THIS web service — a loop). On any
	# backend error, handle_errors below serves the SPA instead, so this can never
	# hard-fail the page (worst case = today's generic preview; the SPA has no
	# /t/ route, so a tab link then lands on its NotFound).
	@sharessr path /v/* /v2/* /v3/* /v1/shared/* /t/* /v1/tabs/*
	handle @sharessr {
		reverse_proxy https://api.kaata.af {
			header_up Host api.kaata.af
		}
	}

	# The signed-in workspace needs Google Identity Services only when its public
	# client ID is configured. Keep that capability scoped to /app documents;
	# links into the workspace must make a full document navigation to receive it.
	# A dedicated handle keeps these headers in force after try_files rewrites
	# nested client-side routes to index.html.
	@workspace {
		path /app /app/*
		not host admin.kaata.af
	}
	handle @workspace {
		root * /srv
		try_files {path} /index.html
		file_server
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.kaata.af wss://api.kaata.af https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}
	}

	# Public, versioned preview PNGs must never fall through to the SPA shell.
	# Bump the filename when changing an image so long-lived crawler caches refresh.
	handle /og/* {
		root * /srv
		@social_png {
			path /og/*.png
			file {path}
		}
		handle @social_png {
			header {
				Content-Type "image/png"
				Content-Disposition "inline"
				Cache-Control "public, max-age=31536000, immutable"
			}
			file_server
		}
		handle {
			respond "Not found" 404
		}
	}

	# Everything else: the static SPA bundle with client-side routing fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# CSP for the SPA (index.html has no inline script; the bundle loads
		# hashed JS/CSS + self-hosted fonts from this origin and calls the API).
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.kaata.af wss://api.kaata.af; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}

		# index.html must always be revalidated: a heuristically-cached stale
		# shell would reference hashed chunks a later deploy has deleted and
		# white-screen until a hard refresh. Hashed assets stay immutable below.
		@html path / /index.html
		header @html Cache-Control "no-cache"

		# Aggressive cache for hashed asset files (Vite emits content-hashed names).
		@hashed_assets path /assets/*
		header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	}

	# Backend unreachable / 5xx → fall back to the SPA shell (its React
	# /v/:token, /v2/:token and /v3/:token views still render bills from the API).
	handle_errors {
		root * /srv
		rewrite * /index.html
		file_server
	}
}
