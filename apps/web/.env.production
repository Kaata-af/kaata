# Production env for the web app. Vite auto-loads this file when running
# `vite build` (NODE_ENV=production), so the bundle picks up these values
# without any build-arg plumbing. Dokploy can override on a per-service
# basis via build args — see apps/web/Dockerfile. CAREFUL: a build-arg line
# declared WITHOUT a value (VITE_X=) overrides this file with an EMPTY
# string — either give the arg a real value or delete the line entirely.

VITE_BACKEND_URL=https://api.kaata.af
VITE_WHATSAPP_CONTACT_URL=https://wa.me/93781696644
VITE_APK_VERSION=0.8.8
# The download button's target: the backend's /v1/download, which serves the
# APK from a local cache with resume (Range) support — see
# apps/backend/internal/visit/apkcache.go. The backend's own APK_DOWNLOAD_URL
# env (the GitHub Release asset) is where that cache warms FROM; this VITE_
# var is where PHONES download from. If unset/empty, env.ts falls back to the
# GitHub release asset URL derived from VITE_APK_VERSION.
VITE_APK_DOWNLOAD_URL=https://api.kaata.af/v1/download
