# Paths are relative to the repository-root build context. This file takes
# precedence over a root .dockerignore when building apps/web/Dockerfile.
# Only the web app and its canonical shared palette enter the context.
**
!apps/
!apps/web/
!apps/web/**
!apps/_shared/
!apps/_shared/brand-palette.json

# Keep local dependencies, generated output and private environment files out.
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/.env
**/.env.*
**/.git
**/.git/**
**/credentials
**/credentials/**
**/*.key
**/*.pem
**/*.p8
**/*.p12
**/*.mobileprovision
**/*.log
**/*.tsbuildinfo
**/.DS_Store
