# The mobile app's first-launch backend URL. Only used until the backend's
# check-in response includes a `migrate_to_backend_url`, after which the app
# persists that override locally and uses it for every subsequent check-in.
# See apps/mobile/lib/api.ts -> getBackendUrl().
#
# For local dev, copy this file to .env.local and pick the value that
# matches your dev surface:
#
#   iOS simulator on the dev machine:      http://localhost:8080
#   Android emulator on the dev machine:   http://10.0.2.2:8080
#   Physical phone via Expo Go (same LAN): http://<your-LAN-IP>:8080
#
# For EAS-built APKs / AABs, the build-time value comes from
# apps/mobile/eas.json's `env` block per profile, NOT this file.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8080

# Google OAuth web client ID. Same string as the backend's
# GOOGLE_WEB_CLIENT_ID. Public — safe to bake into the APK. Used by
# @react-native-google-signin to mint an ID token with this `aud` claim,
# which the backend validates against the same value.
# Default in constants/env.ts kicks in if this is unset.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=987359341353-3bjb28b0hksu9l0ubaogk3p0d7aftjv1.apps.googleusercontent.com

# Sign in with Apple (iOS) needs NO env var on the mobile side — there is
# deliberately nothing to set here. The token audience is the iOS bundle id,
# configured in app.json (`ios.bundleIdentifier: "af.kaata.app"` +
# `ios.usesAppleSignIn: true`, plus the expo-apple-authentication plugin), and
# the backend verifies against its APPLE_CLIENT_ID env, which must equal that
# bundle id. Requirements to actually run it: an iOS build (not Expo Go on
# Android), and the Sign in with Apple capability enabled for af.kaata.app in
# the Apple Developer account.

# Solo-store release flag. "1" hides the multi-employee / Nearby (Bluetooth/WiFi
# mesh) surface — the kaata list in Settings, pairing/scan, and the Nearby sync
# toggle — for a single-shopkeeper build. Cloud backup (the solo-relevant sync)
# stays. Set to "1" in eas.json preview/production; unset/0 (full mesh UI) in dev.
EXPO_PUBLIC_SOLO_STORE_MODE=0
