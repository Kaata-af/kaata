# The mobile app's check-in target. Pick the one that matches your dev surface:
#
#   iOS simulator on the dev machine:  http://localhost:8080
#   Android emulator on the dev machine: http://10.0.2.2:8080
#   Physical phone via Expo Go: http://<your-LAN-IP>:8080
#
# On a phone, "localhost" resolves to the phone itself — not your laptop —
# so you MUST set this to your LAN IP for the check-in to reach the backend.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8080
