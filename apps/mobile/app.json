{
  "expo": {
    "name": "Kaata",
    "slug": "kaata",
    "scheme": "kaata",
    "version": "2.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "af.kaata.app",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": ["iCloud.af.kaata.app"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.af.kaata.app"],
        "com.apple.developer.icloud-services": ["CloudDocuments"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_forcesRTL": false,
        "NSUbiquitousContainers": {
          "iCloud.af.kaata.app": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Kaata",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["DDA9.1"]
          }
        ]
      },
      "buildNumber": "59"
    },
    "android": {
      "package": "af.kaata.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "versionCode": 95
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "forcesRTL": false,
          "supportedLocales": ["en", "fa", "ps"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Kaata uses your contacts so you can add a customer by picking them from your phone book, and saves customers you add in Kaata back to your contacts."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.987359341353-dgceg8n94aem9pgorclo11l4nr5906i8"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Kaata with Face ID when you enable app lock."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kaata uses the camera to scan profile QR codes to connect with people and pairing codes when you add another phone you own.",
          "recordAudioAndroid": false
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "color": "#000000",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "./plugins/withBackupRules",
      "./plugins/withLegacyAndroidTls",
      "./plugins/withAndroidDnsFallback",
      "./plugins/withNearbyWifiNeverForLocation",
      "./plugins/withGradleJvmArgs",
      "./plugins/withNeutralAndroidAccent",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Older Room/WorkManager consumer rules rely on implicit constructor retention.\n# AGP 9 strict R8 mode requires these reflective no-argument constructors explicitly.\n-keep class * extends androidx.room.RoomDatabase {\n    public <init>();\n}\n-keep class * extends androidx.work.InputMerger {\n    public <init>();\n}",
            "usesCleartextTraffic": true
          },
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-sqlite",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a612156b-0f0b-47ea-ac66-b54d880d98aa"
      }
    },
    "owner": "mateesaafi",
    "locales": {
      "en": "./locales/en.json",
      "fa": "./locales/fa.json",
      "ps": "./locales/ps.json"
    }
  }
}
