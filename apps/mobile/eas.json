{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "http://192.168.1.10:8080"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kaata.af",
        "EXPO_PUBLIC_SOLO_STORE_MODE": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kaata.af",
        "EXPO_PUBLIC_SOLO_STORE_MODE": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./credentials/AuthKey_D6G6MNJ4WY.p8",
        "ascApiKeyId": "D6G6MNJ4WY",
        "ascApiKeyIssuerId": "6fb701e4-120e-41d3-866a-2af0ec537819"
      }
    }
  }
}
