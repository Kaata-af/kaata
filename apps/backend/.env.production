# Production env for the Go backend. Not auto-loaded — paste each key into
# Dokploy's Env panel for the kaata-backend service. The values below are
# the reference template; substitute real secrets where placeholders appear.

# Connection string from the kaata-db service (Postgres 18 template).
# Dokploy auto-generates the password — copy it from the Postgres service
# UI and paste here.
POSTGRES_URL=postgres://kaata:<password>@kaata-db:5432/kaata?sslmode=disable

# Listen port inside the container. Must match the port Dokploy binds.
BACKEND_PORT=8080

# Where /v1/download 302-redirects in prod. Update per APK release — the
# web button and any printed QR codes pointing at /v1/download keep working
# without re-issuing the QRs.
APK_DOWNLOAD_URL=https://kaata.af/downloads/kaata-0.1.0.apk

# Optional: soft-migrate installed clients to a new backend URL. When set,
# every check-in response includes this URL; mobile clients persist it
# locally and use it for subsequent check-ins. Leave unset for normal
# operation. Set to "" (empty string) to clear a previously-pushed override.
# MIGRATE_TO_BACKEND_URL=

# Google OAuth web client ID — the "Web application" client from
# https://console.cloud.google.com/apis/credentials in the kaata project.
# Used as the audience when verifying mobile-supplied Google ID tokens at
# POST /v1/auth/google. Public value; the matching client secret is unused
# by our flow (we verify ID tokens, not exchange auth codes).
GOOGLE_WEB_CLIENT_ID=987359341353-3bjb28b0hksu9l0ubaogk3p0d7aftjv1.apps.googleusercontent.com

# Sign in with Apple audience for POST /v1/auth/apple — must equal the iOS
# bundle identifier (apps/mobile/app.json ios.bundleIdentifier). The compiled
# default is already af.kaata.app, so setting this in Dokploy is optional;
# it exists so a bundle-id change (or a future web Services ID) is an env
# edit, not a rebuild. Public value; no Apple key/secret is needed — tokens
# are verified against Apple's public JWKS fetched at runtime.
APPLE_CLIENT_ID=af.kaata.app

# HMAC secret for signing the session JWT issued to mobile after a
# successful Google/Apple sign-in. Generate via `openssl rand -hex 32` and
# paste the result here. NEVER commit the real value to git — this template
# uses a placeholder. Rotating invalidates every currently-issued session.
# JWT_SECRET is the canonical name; SESSION_JWT_SECRET is a legacy alias
# from v0.4 deployments. CAUTION: JWT_SECRET wins when BOTH are set — if
# your live Dokploy env still has SESSION_JWT_SECRET, either keep only that
# name or move the SAME value to JWT_SECRET; never set both to different
# values (all issued sessions would silently invalidate).
JWT_SECRET=<paste-openssl-rand-hex-32-output-here>
