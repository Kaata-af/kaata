POSTGRES_URL=postgres://kaata:kaata_dev@localhost:5432/kaata?sslmode=disable
BACKEND_PORT=8080

# Soft-migration signal. When set, every check-in response carries this URL
# in the `next_backend_url` field. Mobile clients persist it locally and
# switch to it on their next launch. Use this to move the backend to a new
# domain without forcing users to reinstall.
#   - Leave empty (or unset): no migration signal — clients stay on the
#     URL they were built with (EXPO_PUBLIC_BACKEND_URL).
#   - Set to "https://new.example.com": clients migrate to that URL.
#   - Set to "" (empty string) explicitly: clears any prior override on
#     clients, reverting them to their build-time default.
# NEXT_BACKEND_URL=

# Target of the /v1/download redirect. QR codes pointing at
# https://api.kaata.af/v1/download?s=shop_42 will 302 to this URL, so
# updating the APK release just means flipping this env var (no QR reprint).
# Defaults to a localhost path for dev so `go run` works out of the box.
# APK_DOWNLOAD_URL=https://kaata.af/downloads/kaata-0.1.0.apk
