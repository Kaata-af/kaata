{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kaata language review",
  "type": "object",
  "required": ["format_version", "section", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format_version": { "const": 1 },
    "section": { "type": "string" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "translations": {
      "type": "object",
      "required": ["en", "fa", "ps"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": ["string", "null"], "minLength": 1 },
        "fa": { "type": ["string", "null"], "minLength": 1 },
        "ps": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "location": {
      "type": "object",
      "required": ["path", "line"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "locale": { "enum": ["en", "fa", "ps", "shared"] }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "current",
        "proposed",
        "approved_locales",
        "notes",
        "placeholders",
        "sources",
        "references",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "current": { "$ref": "#/$defs/translations" },
        "proposed": { "$ref": "#/$defs/translations" },
        "approved_locales": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["en", "fa", "ps"] }
        },
        "notes": { "type": "string" },
        "context": { "type": "string" },
        "placeholders": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
        "references": { "type": "array", "items": { "$ref": "#/$defs/location" } }
      }
    }
  }
}
