# =============================================================================
# Kaata production env reference — paste each section into Dokploy.
# =============================================================================
# Dokploy doesn't read this file directly. It's a documentation manifest of
# every env var across every deployable surface, organized by where each one
# belongs. Sections below correspond 1:1 to a Dokploy service — paste a
# section's vars into that service's Env (or Build args) panel.
#
# Per-app counterparts (same content, scoped):
#   apps/backend/.env.production
#   apps/web/.env.production
# Mobile prod env lives in apps/mobile/eas.json (EAS Build, not Dokploy).


# -----------------------------------------------------------------------------
# kaata-db (Dokploy → Postgres template)
# -----------------------------------------------------------------------------
# Configured in Dokploy's Postgres template UI, not via env vars. Pick
# Postgres 18, set:
#   - User: kaata
#   - Password: <Dokploy auto-generates; copy somewhere safe>
#   - Database: kaata
# Dokploy then exposes an internal connection string of the form:
#   postgres://kaata:<password>@kaata-db:5432/kaata?sslmode=disable
# Paste that into the backend service's POSTGRES_URL below.


# -----------------------------------------------------------------------------
# kaata-backend (Dokploy → Application → Env)
# -----------------------------------------------------------------------------
# Connection string from the kaata-db service above.
POSTGRES_URL=postgres://kaata:<password>@kaata-db:5432/kaata?sslmode=disable

# Listen port inside the container. Must match the port Dokploy binds.
BACKEND_PORT=8080

# Where /v1/download 302-redirects. Update this per APK release — the web
# button and any printed QR codes pointing at /v1/download keep working.
APK_DOWNLOAD_URL=https://kaata.af/downloads/kaata-0.1.0.apk

# Optional: soft-migrate installed clients to a new backend URL. When set,
# every check-in response includes this URL; mobile clients persist it
# locally and use it for subsequent check-ins. Leave unset for normal
# operation. Set to "" (empty string) to clear a previously-pushed override.
# MIGRATE_TO_BACKEND_URL=

# --- Auth providers ---
# Google OAuth "Web application" client id — audience for verifying Google ID
# tokens at POST /v1/auth/google. Public value; the client secret is unused.
GOOGLE_WEB_CLIENT_ID=987359341353-3bjb28b0hksu9l0ubaogk3p0d7aftjv1.apps.googleusercontent.com

# Sign in with Apple audience for POST /v1/auth/apple — must equal the iOS
# bundle id (apps/mobile/app.json ios.bundleIdentifier). Compiled default is
# already af.kaata.app, so this line is optional; it exists so a bundle-id
# change is an env edit, not a rebuild. No Apple key/secret needed — tokens
# verify against Apple's public JWKS fetched at runtime.
APPLE_CLIENT_ID=af.kaata.app

# HMAC secret for the session JWTs issued after Google/Apple sign-in.
# Generate with `openssl rand -hex 32`; NEVER commit the real value.
# JWT_SECRET is the canonical name; SESSION_JWT_SECRET is the legacy v0.4
# alias. CAUTION: JWT_SECRET wins when BOTH are set — if your live Dokploy
# env still has SESSION_JWT_SECRET, either keep only that name or move the
# SAME value here; never set both to different values (all issued sessions
# would silently invalidate).
JWT_SECRET=<paste-openssl-rand-hex-32-output-here>

# See apps/backend/.env.example for the full optional set (ADMIN_API_KEY,
# OPERATOR_* analytics filters, WEB_BASE_URL/SHARE_LINK_BASE_URL/
# PUBLIC_API_BASE_URL, BACKEND_DEVICE_ID + KAATA_ENV, mesh signing keys).


# -----------------------------------------------------------------------------
# kaata-web (Dokploy → Application → Build args)
# -----------------------------------------------------------------------------
# Vite reads these at build time and bakes them into the static bundle.
# Changing any of them requires a redeploy of the web service. All have
# sensible defaults in apps/web/Dockerfile — override only when you need to
# point at a non-default URL (e.g. staging).
VITE_BACKEND_URL=https://api.kaata.af
VITE_WHATSAPP_CONTACT_URL=https://wa.me/93781696644


# -----------------------------------------------------------------------------
# Mobile (apps/mobile/eas.json → build.<profile>.env, NOT Dokploy)
# -----------------------------------------------------------------------------
# Mobile builds run on EAS Build (Expo's cloud), not Dokploy. The build-time
# env lives in apps/mobile/eas.json under `build.preview.env` and
# `build.production.env`:
#
#   EXPO_PUBLIC_BACKEND_URL=https://api.kaata.af   (first-launch fallback URL;
#     after the first check-in the backend's `migrate_to_backend_url`
#     mechanism takes over)
#   EXPO_PUBLIC_SOLO_STORE_MODE=1                  (hides the multi-employee /
#     Nearby mesh surface in store builds)
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (Google sign-in audience, same value as the
# backend's GOOGLE_WEB_CLIENT_ID) is NOT set in eas.json — production builds
# use the default baked into apps/mobile/constants/env.ts.
#
# Sign in with Apple needs NO mobile env var: the audience is implied by the
# iOS bundle id (apps/mobile/app.json → ios.bundleIdentifier + usesAppleSignIn)
# and must match the backend's APPLE_CLIENT_ID above. Prerequisite outside this
# repo: the Sign in with Apple capability enabled for af.kaata.app in the
# Apple Developer account.
