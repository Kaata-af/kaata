# =============================================================================
# Kaata production env reference — paste each section into Dokploy.
# =============================================================================
# Dokploy doesn't read this file directly. It's a documentation manifest of
# every env var across every deployable surface, organized by where each one
# belongs. Sections below correspond 1:1 to a Dokploy service — paste a
# section's vars into that service's Env (or Build args) panel.
#
# Per-app counterparts (same content, scoped):
#   apps/backend/.env.production
#   apps/web/.env.production
# Mobile prod env lives in apps/mobile/eas.json (EAS Build, not Dokploy).


# -----------------------------------------------------------------------------
# kaata-db (Dokploy → Postgres template)
# -----------------------------------------------------------------------------
# Configured in Dokploy's Postgres template UI, not via env vars. Pick
# Postgres 18, set:
#   - User: kaata
#   - Password: <Dokploy auto-generates; copy somewhere safe>
#   - Database: kaata
# Dokploy then exposes an internal connection string of the form:
#   postgres://kaata:<password>@kaata-db:5432/kaata?sslmode=disable
# Paste that into the backend service's POSTGRES_URL below.


# -----------------------------------------------------------------------------
# kaata-backend (Dokploy → Application → Env)
# -----------------------------------------------------------------------------
# Connection string from the kaata-db service above.
POSTGRES_URL=postgres://kaata:<password>@kaata-db:5432/kaata?sslmode=disable

# Listen port inside the container. Must match the port Dokploy binds.
BACKEND_PORT=8080

# Where /v1/download 302-redirects. Update this per APK release — the web
# button and any printed QR codes pointing at /v1/download keep working.
APK_DOWNLOAD_URL=https://kaata.af/downloads/kaata-0.1.0.apk

# Optional: soft-migrate installed clients to a new backend URL. When set,
# every check-in response includes this URL; mobile clients persist it
# locally and use it for subsequent check-ins. Leave unset for normal
# operation. Set to "" (empty string) to clear a previously-pushed override.
# MIGRATE_TO_BACKEND_URL=


# -----------------------------------------------------------------------------
# kaata-web (Dokploy → Application → Build args)
# -----------------------------------------------------------------------------
# Vite reads these at build time and bakes them into the static bundle.
# Changing any of them requires a redeploy of the web service. All have
# sensible defaults in apps/web/Dockerfile — override only when you need to
# point at a non-default URL (e.g. staging).
VITE_BACKEND_URL=https://api.kaata.af
VITE_WHATSAPP_CONTACT_URL=https://wa.me/93781696644
VITE_APK_VERSION=0.1.0
# Leave unset to use the in-bundle APK at /downloads/kaata-${VERSION}.apk
# served by Caddy from public/. Set when distribution moves to a CDN or
# the Play Store.
# VITE_APK_DOWNLOAD_URL=


# -----------------------------------------------------------------------------
# Mobile (apps/mobile/eas.json → build.<profile>.env, NOT Dokploy)
# -----------------------------------------------------------------------------
# Mobile builds run on EAS Build (Expo's cloud), not Dokploy. The build-time
# env lives in apps/mobile/eas.json under `build.preview.env` and
# `build.production.env`. The only var is:
#
#   EXPO_PUBLIC_BACKEND_URL=https://api.kaata.af
#
# Baked into the APK as the first-launch fallback URL. After the first
# successful check-in, the backend's `migrate_to_backend_url` mechanism
# takes over and the app uses whatever URL the server tells it to.
